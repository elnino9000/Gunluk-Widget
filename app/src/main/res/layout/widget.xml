<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Tüm sahne (zemin, derece, simgeler, tahmin) bu resimde; dokununca yeniler -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_initial" />

    <!-- Tarih: dokununca takvim açılır. Konumu çalışma anında ayarlanır. -->
    <FrameLayout
        android:id="@+id/date_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:includeFontPadding="false"
            android:letterSpacing="0.07"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#FFC8102E"
            android:textSize="15dp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Saat: dokununca saat / alarm ekranı açılır -->
    <FrameLayout
        android:id="@+id/time_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextClock
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:fontFamily="sans-serif"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF111111"
            android:textSize="62dp" />
    </FrameLayout>
</FrameLayout>
